# =============================================================================
# fullstack-starter - variables de entorno
# Copiá este archivo a .env (cp .env.example .env) y completá los valores.
# NUNCA commitees .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Desarrollo multiplataforma
# -----------------------------------------------------------------------------
# Windows: true  (los bind mounts no propagan eventos de archivos -> polling)
# Mac:     false (eventos nativos)
# scripts/dev-up.* lo ajusta según el SO al crear .env.
DEV_FILE_POLLING=false
# Intervalo de polling en milisegundos (solo si DEV_FILE_POLLING=true)
DEV_FILE_POLLING_INTERVAL_MS=1000

TZ=America/Argentina/Buenos_Aires

# -----------------------------------------------------------------------------
# MySQL 8.4
# -----------------------------------------------------------------------------
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
# Puerto expuesto en el host (solo dev, ligado a 127.0.0.1)
MYSQL_HOST_PORT=3306

# -----------------------------------------------------------------------------
# Backend (Spring Boot)
# -----------------------------------------------------------------------------
# dev | prod  (Swagger y seeds solo en dev)
# En desarrollo (docker-compose.override.yml) se fuerza "dev"; este valor solo
# aplica al levantar la base sola (docker compose -f docker-compose.yml ...).
SPRING_PROFILES_ACTIVE=dev
BACKEND_HOST_PORT=8080
BACKEND_DEBUG_PORT=5005

# Secreto HMAC para firmar JWT: Base64, mínimo 256 bits (32 bytes decodificados).
# Generalo con scripts/gen-secret.sh | scripts/gen-secret.ps1 (corre en Docker).
# scripts/dev-up.* lo completa solo si está vacío.
JWT_SECRET=
JWT_ISSUER=app
# Duraciones en formato ISO-8601
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P30D
# Vigencia del link de restablecer contraseña (duración ISO-8601, default PT1H).
# PASSWORD_RESET_TTL=PT1H
# Cache de validación de sesión (default PT30S; PT0S la desactiva).
# SESSION_CHECK_CACHE_TTL=PT30S
INVITATION_TTL=PT72H

# Protección contra fuerza bruta en login
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_DURATION=PT15M

# Orígenes permitidos por CORS (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8088

# URL pública del admin web (se usa para armar los links de invitación)
APP_PUBLIC_WEB_URL=http://localhost:5173

# ADMIN inicial (todos los perfiles, incluido prod). Al arrancar, si NO existe ningún
# usuario ADMIN y ADMIN_BOOTSTRAP_EMAIL está definido, se crea ese usuario y se le envía
# una invitación por mail para que defina su contraseña (nunca hay contraseñas en variables).
# Nombre/apellido opcionales (por defecto "Admin" / "App").
# ADMIN_BOOTSTRAP_EMAIL=admin@example.local
# ADMIN_BOOTSTRAP_FIRST_NAME=Admin
# ADMIN_BOOTSTRAP_LAST_NAME=App

# Usuarios de prueba SOLO DEV (perfil dev; el compose de prod no los recibe). Al arrancar se
# crean ya ACTIVOS si el email no existe (idempotente). Contraseña vacía = no se crea ese
# usuario. Política: 10-72 caracteres, con letra y número. NUNCA usar estas en producción.
# En dev, si se crea el ADMIN del seed, el bootstrap de arriba no manda invitación duplicada.
# DEV_SEED_ADMIN_EMAIL=admin@example.local
# DEV_SEED_ADMIN_PASSWORD=DevAdmin12345
# DEV_SEED_USER_EMAIL=user@example.local
# DEV_SEED_USER_PASSWORD=DevUser12345


# -----------------------------------------------------------------------------
# Mail (en dev apunta a Mailpit)
# -----------------------------------------------------------------------------
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@example.local
MAILPIT_UI_HOST_PORT=8025
# Si es false el backend no envía mails y solo los loguea (default true).
# MAIL_ENABLED=true
# Timeout (ms) de conexión/lectura/escritura SMTP (default 5000).
# MAIL_SMTP_TIMEOUT_MS=5000
#
# Producción provisoria con Gmail (hasta tener dominio propio). Reemplaza los valores de arriba.
# Requiere verificación en 2 pasos y una contraseña de aplicación generada en
# https://myaccount.google.com/apppasswords. MAIL_FROM debe ser la misma cuenta.
# Límite aproximado de Gmail: 500 mails/día. En dev se queda en Mailpit.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tu-cuenta@gmail.com
# MAIL_PASSWORD=<contraseña de aplicación de 16 caracteres>
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_FROM=tu-cuenta@gmail.com


# -----------------------------------------------------------------------------
# Admin web (React)
# -----------------------------------------------------------------------------
# Build de producción servido por nginx
ADMIN_WEB_HOST_PORT=8088
# Vite dev server
ADMIN_WEB_DEV_HOST_PORT=5173

# -----------------------------------------------------------------------------
# Mobile (Expo / Metro)
# -----------------------------------------------------------------------------
# Metro anuncia el 8081 al celular: dejalo en 8081 salvo que sepas lo que hacés.
EXPO_HOST_PORT=8081
# IP LAN de tu máquina (para abrir la app con Expo Go en el celular).
# Con scripts/dev-up.(sh|ps1) este valor y EXPO_PUBLIC_API_URL se DETECTAN SOLOS
# (ganan sobre este archivo; forzar con APP_LAN_IP). Solo se usan tal cual si
# corrés `docker compose up` directo.
# Windows: ipconfig  |  Mac: ipconfig getifaddr en0
REACT_NATIVE_PACKAGER_HOSTNAME=192.168.0.10
# true = modo tunnel (cuando el celular no está en la misma red)
EXPO_TUNNEL=false
# Access token de tu cuenta Expo (expo.dev -> Account settings -> Access tokens). SECRETO.
# Necesario para abrir la app en Expo Go desde iPhone: la misma cuenta tiene que estar
# logueada en la app Expo Go del celular. En Android no hace falta. Vacio = sin login.
EXPO_TOKEN=
# URL del backend vista DESDE EL CELULAR (IP LAN + BACKEND_HOST_PORT, no localhost)
EXPO_PUBLIC_API_URL=http://192.168.0.10:8080/api/v1

# -----------------------------------------------------------------------------
# Herramientas de dev
# -----------------------------------------------------------------------------
# Adminer y Mailpit UI se publican solo en 127.0.0.1
ADMINER_HOST_PORT=8089

# Notificaciones al admin (opcional): casilla que recibe avisos internos del backend.
# Vacía = solo se registra en el log (sin datos personales).
# ADMIN_NOTIFY_EMAIL=

# ID del proyecto EAS (`eas init`, cuenta Expo del titular). Solo para builds con EAS / push.
# EAS_PROJECT_ID=

{
  "name": "@app/api-types",
  "version": "0.0.0",
  "private": true,
  "description": "Tipos TypeScript generados desde el OpenAPI del backend. No editar a mano.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "openapi-typescript ./openapi.json -o ./src/schema.d.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "~6.0.0"
  }
}
